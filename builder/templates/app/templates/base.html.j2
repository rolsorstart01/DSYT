<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ config.project_name if config else 'DSYT' }}</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="{{ url_for('static', filename='styles.css') }}">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark" style="background-color: {{ config.primary_color if config else '#0f4c81' }};">
  <div class="container">
    <a class="navbar-brand" href="/">DSYT</a>
    <div>
      <a class="btn btn-light btn-sm" href="/market">Market</a>
      <a class="btn btn-light btn-sm" href="/portfolio">Portfolio</a>
      <a class="btn btn-light btn-sm" href="/leaderboard">Leaderboard</a>
      <a class="btn btn-warning btn-sm" href="/admin">Admin</a>
      <a class="btn btn-outline-light btn-sm" href="/auth">Login</a>
      <a class="btn btn-outline-light btn-sm" href="/logout">Logout</a>
    </div>
  </div>
</nav>
<div class="container py-4">
  {% with messages = get_flashed_messages() %}
    {% for m in messages %}
      <div class="alert alert-info">{{ m }}</div>
    {% endfor %}
  {% endwith %}
  {% block content %}{% endblock %}
</div>
</body>
</html>
