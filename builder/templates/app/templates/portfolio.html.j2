{% extends 'base.html' %}
{% block content %}
<h2>Your Portfolio</h2>
<p><strong>Cash:</strong> {{ cash }} | <strong>Net Worth:</strong> {{ net_worth }}</p>
<table class="table">
<thead><tr><th>Symbol</th><th>Qty</th><th>Price</th><th>Value</th></tr></thead>
<tbody>{% for row in rows %}<tr><td>{{ row.symbol }}</td><td>{{ row.qty }}</td><td>{{ row.price }}</td><td>{{ row.value }}</td></tr>{% endfor %}</tbody>
</table>
{% endblock %}
